GOOGLE_MEET_ENABLED="true"

# Usado pelo script npm run google:auth
GOOGLE_OAUTH_LOCAL_PORT="53682"

# ---------------------------------------------------------
# NEON POSTGRES — necessário quando DATA_MODE=neon
